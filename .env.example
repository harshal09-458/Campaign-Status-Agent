# Copy this file to .env and fill in real values. Never commit .env.
# Live/manual runs post to Slack via the MCP connector (no token needed).
# The unattended local-cron path (tools/post_to_slack.py) instead uses a
# real bot token here, since MCP only works inside a live Claude session —
# see workflows/post_campaign_status.md "Automation" section.

ITERABLE_API_KEY=
POPLAR_API_KEY=
SLACK_BOT_TOKEN=
